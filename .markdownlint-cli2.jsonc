{
  "config": {
    "MD013": false,
    // Lets a README open with a centred header block before its title.
    "MD033": { "allowed_elements": ["div"] },
    "MD041": { "allow_preamble": true }
  },
  "globs": ["**/*.md"],
  // Issue templates start at section headings because GitHub renders them inside the issue body.
  "ignores": ["node_modules", ".github/ISSUE_TEMPLATE"]
}

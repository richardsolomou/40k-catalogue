  "data": {
    "document": "Core Rules",
    "section": "24. Core Abilities",
    "ruleNumber": "24.01",
    "summary": "Core abilities appear on datasheets and weapon profiles. On a weapon, the ability name is bold and bracketed. Some apply only to attacks against targets carrying at least one listed keyword. In the examples, the restriction is VEHICLE for **[Lethal Hits](vsdata:core-rule/lethal-hits)**, and either INFANTRY or BEASTS for **[Sustained Hits](vsdata:core-rule/sustained-hits)** 1. A check for a named ability ignores its parameter. A model with a D3 or D6 value for **[Deadly Demise](vsdata:core-rule/deadly-demise)** qualifies for a check for that ability.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.6.0",
        "dataBuild": 946,
        "releaseDate": "2026-09-02"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "ability-labels-and-conditions",
          "locations": [
            "unit-datasheet",
            "weapon-profile"
          ],
          "weaponNotation": {
            "bold": true,
            "squareBrackets": true,
            "bareExample": "Blast"
          },
          "keywordRestriction": {
            "scope": "weapon-attacks",
            "targetKeywordMatch": "any-listed",
            "examples": [
              {
                "ability": "Lethal Hits",
                "target": [
                  "VEHICLE"
                ]
              },
              {
                "ability": "Sustained Hits",
                "value": 1,
                "target": [
                  "INFANTRY",
                  "BEASTS"
                ]
              }
            ]
          },
          "namedAbilityCheck": {
            "subjectTypes": [
              "model",
              "unit"
            ],
            "ignoreParameters": true,
            "example": {
              "ability": "Deadly Demise",
              "acceptedValues": [
                "D3",
                "D6"
              ]
            }
          }
        }
      }
    }
  }

    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "cumulative": {
            "requires": "labelled condition following a standard condition is met",
            "awards": [
              "standard condition VP",
              "cumulative condition VP"
            ]
          },
          "or": {
            "requires": "one or more labelled alternatives follow a standard condition",
            "awards": [
              "standard condition VP or one alternative VP"
            ],
            "maximumConditionsScored": 1
          }
        }
      }
    }

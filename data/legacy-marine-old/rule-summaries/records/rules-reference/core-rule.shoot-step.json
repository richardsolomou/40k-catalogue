  "data": {
    "document": "Core Rules",
    "section": "10. Shooting Phase",
    "ruleNumber": "10.02",
    "summary": "The active player resolves shooting 1 unit at a time, with whichever eligible units they choose. A unit qualifies if it has not been picked to shoot yet in this phase and is on the battlefield. For each unit:\n\n1. Pick it; it is now **selected to shoot**.\n2. Choose a shooting type it is eligible for and resolve it: [Normal](vsdata:core-rule/normal-shooting), [Assault](vsdata:core-rule/assault-shooting), [Close-Quarters](vsdata:core-rule/close-quarters-shooting), [Indirect](vsdata:core-rule/indirect-shooting) or one from another rule.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.6.0",
        "dataBuild": 946,
        "releaseDate": "2026-09-02"
      }
    ],

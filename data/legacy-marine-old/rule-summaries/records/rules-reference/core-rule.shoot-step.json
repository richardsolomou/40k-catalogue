      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "phase-step",
          "phase": "shooting",
          "actor": "active-player",
          "loop": {
            "unitsAtATime": 1,
            "until": "all-chosen-units-selected-and-attacks-resolved",
            "optionalPerUnit": true
          },
          "eligibility": {
            "all": [
              "on-battlefield",
              "not-already-selected-to-shoot-this-phase"
            ]
          },
          "subSteps": [

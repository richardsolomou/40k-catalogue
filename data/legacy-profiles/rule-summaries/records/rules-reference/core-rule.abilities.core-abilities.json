  "data": {
    "document": "Core Rules",
    "section": "24. Core Abilities",
    "ruleNumber": "24.01",
    "order": 253,
    "anchor": "24.01",
    "summary": "Datasheets list core abilities; weapon profiles list weapon abilities, shown bold in square brackets, as in **[[BLAST]](vsdata:weapon-ability/blast)**. A weapon is often named after an ability it has, so a **[[BLAST]](vsdata:weapon-ability/blast)** weapon is one with that ability.\n\nA weapon ability followed by keywords works only against a target unit with 1 or more of them.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.0",
        "dataBuild": 963,
        "releaseDate": "2026-09-30"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "ability-labels-and-conditions",
          "locations": [
            "unit-datasheet",
            "weapon-profile"
          ],
          "weaponNotation": {
            "bold": true,
            "squareBrackets": true,
            "bareExample": "Blast"
          },
          "keywordRestriction": {
            "scope": "weapon-attacks",
            "targetKeywordMatch": "any-listed",
            "examples": [
              {

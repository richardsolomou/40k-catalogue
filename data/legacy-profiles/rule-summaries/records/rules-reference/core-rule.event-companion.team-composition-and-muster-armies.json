    "facts": {
      "format": "catalogue-core-facts",
      "fields": {
        "mode": "teams",
        "timing": "before-event",
        "captain": {
          "count": 1,
          "duties": [
            "ensure timely army list submission",
            "ensure scores are submitted at each round end"
          ]
        },
        "factionKeyword": {
          "maxPlayersPerTeamPerKeyword": 1,
          "includesAlliedUnits": true,
          "exceptions": [
            "ally rules change faction keywords",
            "same datasheet occurs in multiple Codexes under different faction keywords"
          ],
          "example": {
            "first": "Chaos Daemons",
            "second": "Khorne Daemons",
            "secondCodex": "World Eaters"
          }
        },
        "muster": {
          "procedure": "Warhammer 40,000 app",
          "then": {
            "dispositionCardsPerPlayer": 1,
            "mustBeAvailableToPlayer": true,
            "recordOnRoster": true
          }
        },
        "forceDisposition": {
          "capPerDisposition": {
            "teamSizeDivisor": 5,
            "rounding": "up"
          },
          "fivePlayerTeam": {
            "teamSize": 5,
            "distinctRequired": 5,
            "maxPlayersPerDisposition": 1
          },
          "eightPlayerTeam": {
            "teamSize": 8,
            "distinctRequired": 5,
            "additionalPlayers": 3,
            "maxPlayersPerDisposition": 2
          }
        },
        "then": "continue remaining event mission sequence"
      }
    }

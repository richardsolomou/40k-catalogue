  "data": {
    "document": "Event Companion",
    "section": "Event Companion",
    "summary": "Win path means the order of wins and losses, not their count. Compare 2 players who are both 3–1:\n\n- one lost the opening game, then won 3 in a row, and is likely in good spirits\n- the other won the first 3, then lost: a sharp letdown after opening 3–0\n\nPairing by win path gives opponents a shared recent experience, which helps both enjoy the game; it also tends to pair players by strength of schedule.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"
      }
    ],
    "facts": {

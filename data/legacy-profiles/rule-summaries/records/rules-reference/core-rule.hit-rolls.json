  "data": {
    "document": "Core Rules",
    "section": "05. Attack Sequence",
    "ruleNumber": "05.01",
    "summary": "Roll 1 D6 **hit roll** per attack die and check these 4 cases in order; the first that matches applies:\n\n- an unmodified 1 fails\n- an unmodified 6 is a **critical hit**\n- a roll at or above the attack's BS or WS hits\n- anything else fails",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "attack-sequence-step",
          "step": 1,
          "of": "05.00",
          "roll": {
            "per": "attack-die",
            "dice": "1D6"
          },
          "evaluation": "first-matching-row",
          "rows": [
            {
              "order": 1,
              "if": {
                "unmodifiedRoll": 1
              },
              "result": "fail"
            },
            {
              "order": 2,
              "if": {
                "unmodifiedRoll": 6
              },
              "result": "critical-hit"
            },
            {
              "order": 3,
              "if": {
                "rollAtLeast": "BS-or-WS"
              },
              "result": "hit"
            },
            {
              "order": 4,
              "if": "any-other-result",
              "result": "fail"
            }

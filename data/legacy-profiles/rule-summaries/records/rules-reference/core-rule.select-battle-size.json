  "data": {
    "document": "Core Rules",
    "section": "25. Muster Armies",
    "ruleNumber": "25.03",
    "order": 301,
    "anchor": "25.03",
    "summary": "Agree a battle size with your opponent. Each player gets:\n\n- Incursion: 1,000 points, 2 Detachment Points (DP), 2 Enhancements and 2 units per datasheet name.\n- Strike Force: 2,000 points, 3 DP, 4 Enhancements and 3 units per datasheet name.\n\nDP unlock detachments, and unit points come from the official Warhammer 40,000 app. The per-name limit doubles for **BATTLELINE** or **DEDICATED TRANSPORT** units, and each **EPIC HERO** is limited to 1 at either size.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "battle-size-limits",
          "selection": {
            "actors": "players-jointly",
            "perPlayer": true,
            "unitPrices": "Warhammer 40,000 app",
            "detachmentPointsUse": "unlock-detachments"
          },
          "unitLimitScope": "identical-datasheet-name",
          "sizes": {
            "incursion": {
              "armyPoints": 1000,
              "detachmentPoints": 2,
              "enhancements": 2,
              "unitsPerName": 2
            },
            "strike-force": {
              "armyPoints": 2000,
              "detachmentPoints": 3,
              "enhancements": 4,
              "unitsPerName": 3
            }
          },
          "exceptions": [

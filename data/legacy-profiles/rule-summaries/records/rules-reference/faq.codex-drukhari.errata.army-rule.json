    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "faq": {
            "entryType": "errata",
            "publicationId": "ac31baaa-cd6b-40c0-9667-ad13cb87d2c4",
            "addsRule": {
              "name": "Corsairs and Travelling Players",
              "armyFaction": "DRUKHARI",
              "allowedUnits": {
                "keywordsAny": [
                  "HARLEQUINS",
                  "ANHRATHE"
                ],
                "despiteLackingFactionKeyword": "DRUKHARI"
              },
              "combinedPointsLimit": {
                "Incursion": 250,
                "Strike Force": 500,
                "Onslaught": 750
              },
              "cannotBeWarlord": true,
              "cannotBeGivenEnhancements": true
            }
          }
        }
      }
    }
  }

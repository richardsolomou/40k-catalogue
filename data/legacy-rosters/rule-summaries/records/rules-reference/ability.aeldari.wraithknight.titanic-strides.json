  "data": {
    "ruleType": "unit-ability",
    "group": "Wraithknight",
    "summary": "Whenever this model makes an Advance, Fall Back or Normal move, it can pass through models other than TITANIC models, and through terrain sections no taller than 4\". During such a move it may move into enemy models' Engagement Range, yet it must not end the move in their Engagement Range. It can also pass through terrain sections taller than 4\"; if it does so, roll a D6 once it has moved, and on a roll of 1 this model becomes Battle-shocked.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.0",
        "dataBuild": 963,
        "releaseDate": "2026-09-30"
      }
    ],
    "facts": {
      "format": "catalogue-core-facts",
      "fields": {
        "ability": {
          "during": [
            "normal-move",
            "advance-move",
            "fall-back-move"
          ],
          "effects": [
            {
              "moveThrough": {
                "models": {
                  "keywordsNone": [
                    "TITANIC"
                  ]
                },
                "terrainSectionsMaxHeightInches": 4
              }
            },
            {
              "mayCrossEngagementRange": true,
              "cannotEndWithinEngagementRange": true
            },
            {
              "moveThroughTallerTerrain": {
                "overHeightInches": 4,
                "afterMove": {
                  "roll": "D6",
                  "onResult": 1,
                  "becomes": "battle-shocked"
                }
              }
            }
          ]
        }
      }
    }
  }
}

    "summary": "For a **MALIGNANT PLAGUECASTER**. Whenever a **PLAGUE LEGIONS** unit is tested for [Battle-shock](vsdata:core-rule/battle-shock) 12\" or closer to the bearer, that test gets +1. If the test is passed:\n\n- 1 of its models regains lost wounds, up to D3\n- a **BATTLELINE** unit may instead return as many as D3 **destroyed** models to it",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.0",
        "dataBuild": 963,
        "releaseDate": "2026-09-30"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "enhancement": {
          "type": "model",
          "points": 20,
          "eligibility": {
            "basis": "app-eligibility-rows",
            "anyOf": [
              {
                "keywords": [
                  "MALIGNANT PLAGUECASTER"
                ]
              }
            ]
          }
        },
        "detail": {
          "kind": "enhancement",
          "detachment": "Tallyband Summoners",
          "effects": [
            {
              "trigger": "battle-shock-test",
              "select": {
                "keywordsAll": [
                  "PLAGUE LEGIONS"
                ],
                "withinInches": 12,
                "of": "bearer"
              },
              "testModifier": 1,
              "onPass": {
                "regainLostWounds": {
                  "models": 1,
                  "upTo": "D3"
                },
                "ifBattleline": {
                  "optional": true,
                  "instead": true,
                  "returnDestroyedModels": {
                    "upTo": "D3"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }

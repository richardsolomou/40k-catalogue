  "data": {
    "ruleType": "detachment-rule",
    "group": "Subversion Assets",
    "summary": "Your **PHOBOS** and **SCOUT SQUAD** units gain **Transhuman Perception**, which lets each of them mark 1 enemy unit as **detected** during your Shooting phase, as long as that enemy unit is **visible** to it and within 12\". Detected units have their **detection range** increased by 3\".",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.6.0",
        "dataBuild": 946,
        "releaseDate": "2026-09-02"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "detachment-rule",
          "detachment": "Subversion Assets",
          "grantsAbility": {
            "name": "Transhuman Perception",
            "to": {
              "side": "friendly",
              "keywordsAny": [
                "PHOBOS",
                "SCOUT SQUAD"
              ]
            },
            "when": {
              "turn": "own",
              "phase": "shooting"
            },
            "optional": true,
            "select": {
              "side": "enemy",
              "count": 1,
              "visible": true,
              "withinInches": 12
            },
            "status": "detected"
          },
          "detected": {
            "detectionRangeDeltaInches": 3
          }
        }
      }
    }
  }
}

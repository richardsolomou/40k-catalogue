  "data": {
    "document": "Core Rules",
    "section": "24. Core Abilities",
    "ruleNumber": "24.01",
    "summary": "Datasheets list core abilities; weapon profiles list weapon abilities, shown bold in square brackets.\n\n- A weapon ability followed by keywords works only against a target unit with at least one of them: **[[LETHAL HITS: VEHICLE]](vsdata:weapon-ability/lethal-hits)** affects only attacks on **VEHICLE** units, and **[[SUSTAINED HITS 1: INFANTRY/BEASTS]](vsdata:weapon-ability/sustained-hits)** only attacks on **INFANTRY** or **BEASTS** units.\n- A rule that looks for a named ability ignores its number: any **[Deadly Demise](vsdata:core-ability/deadly-demise)** model counts, whether its value is 1, D3 or D6.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.0",
        "dataBuild": 963,
        "releaseDate": "2026-09-30"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "ability-labels-and-conditions",
          "locations": [
            "unit-datasheet",
            "weapon-profile"
          ],
          "weaponNotation": {
            "bold": true,
            "squareBrackets": true,
            "bareExample": "Blast"
          },
          "keywordRestriction": {
            "scope": "weapon-attacks",
            "targetKeywordMatch": "any-listed",
            "examples": [
              {
                "ability": "Lethal Hits",
                "target": [
                  "VEHICLE"
                ]
              },
              {
                "ability": "Sustained Hits",
                "value": 1,
                "target": [
                  "INFANTRY",
                  "BEASTS"
                ]
              }
            ]
          },
          "namedAbilityCheck": {
            "subjectTypes": [
              "model",
              "unit"
            ],
            "ignoreParameters": true,
            "example": {
              "ability": "Deadly Demise",
              "acceptedValues": [
                "D3",
                "D6"
              ]
            }
          }
        }
      }
    }
  }

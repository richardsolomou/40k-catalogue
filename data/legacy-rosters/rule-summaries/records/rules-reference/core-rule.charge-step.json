  "data": {
    "document": "Core Rules",
    "section": "11. Charge Phase",
    "ruleNumber": "11.02",
    "order": 151,
    "anchor": "11.02",
    "summary": "The active player declares and resolves charges 1 unit at a time, with whichever eligible units they choose. For each unit:\n\n1. Pick a friendly unit that is eligible and has yet to declare a charge in this phase; it declares one.\n2. Roll 2D6 for its **charge roll**; the total sets the **maximum distance** of its **[charge move](vsdata:core-rule/charge-move)**.\n3. If a [charge move](vsdata:core-rule/charge-move) is possible and you still want it, the unit makes it; otherwise it does not. Either way, the charge is now resolved.\n\nA unit on the battlefield is eligible unless a rule says otherwise; rules that bar it include:\n\n- being more than 12\" from every enemy unit\n- being **[engaged](vsdata:core-rule/engagement-range)**\n- having [Advanced](vsdata:core-rule/advance-move) or [Fallen Back](vsdata:core-rule/fall-back) this turn",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.6.0",
        "dataBuild": 946,
        "releaseDate": "2026-09-02"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "phase-step",
          "phase": "charge",
          "actor": "active-player",
          "loop": {
            "unitsAtATime": 1,
            "until": "all-chosen-units-declared-and-resolved",
            "optionalPerUnit": true
          },
          "subSteps": [
            {
              "order": 1,
              "name": "Declare Charge",
              "select": {
                "count": 1,
                "side": "friendly",
                "notAlready": "declared-charge-this-phase",
                "constraint": "eligible-to-declare-charge"
              },
              "setsState": "declared-charge"
            },
            {
              "order": 2,
              "name": "Make Charge Roll",
              "roll": "2D6",
              "result": "maximum-charge-move-distance"
            },
            {
              "order": 3,
              "name": "Charge Move",
              "move": {
                "if": [
                  "charge-move-possible",
                  "player-still-wants"
                ],
                "otherwise": "no-charge-move"
              },
              "then": "charge-resolved"
            }
          ],
          "eligibility": {
            "requires": [
              "on-battlefield"
            ],
            "unlessOtherwiseStated": true,
            "ineligibleIf": [
              {
                "notWithinInches": 12,
                "of": "one-or-more-enemy-units"
              },
              {
                "state": "engaged"
              },
              {
                "madeThisTurn": [
                  "advance-move",
                  "fall-back-move"
                ]
              }
            ]
          },
          "noSkip": {
            "allUnitsSelected": false
          }
        }
      }
    }

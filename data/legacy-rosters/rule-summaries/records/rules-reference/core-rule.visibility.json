  "data": {
    "document": "Core Rules",
    "section": "06. Other Concepts",
    "ruleNumber": "06.01",
    "summary": "Test sight with a straight 1 mm line between parts of the two models, ignoring their own unit members. Any visible part establishes model visibility. Full visibility requires the whole facing side. One visible member makes a unit visible. Full unit visibility requires each member to be fully visible. For a visible-unit instruction with no stated observer, use the unit applying the rule.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.0",
        "dataBuild": 963,
        "releaseDate": "2026-09-30"
      }
    ],
    "facts": {
      "format": "catalogue-core-facts",
      "fields": {
        "kind": "visibility",
        "lineOfSight": {
          "shape": "straight",
          "widthMm": 1,
          "endpoints": "any-part-of-each-model",
          "ignoreOtherModelsIn": [
            "observer-unit",
            "observed-unit"
          ],
          "subjectToTerrainVisibility": true
        },
        "modelVisible": "any-part-visible",
        "modelFullyVisible": "every-part-facing-observer-visible",
        "unitVisible": "one-or-more-visible-models",
        "unitFullyVisible": {
          "allModelsFullyVisible": true,
          "lookThroughOtherMembers": true
        },
        "defaultObserver": {
          "appliesWhen": "rule-calls-for-visible-unit-without-stating-observer",
          "observer": "unit-using-rule"
        }
      }
    }
  }

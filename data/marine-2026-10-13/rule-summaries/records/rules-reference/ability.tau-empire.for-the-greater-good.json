          "armyFaction": "T'AU EMPIRE",
          "timing": {
            "owner": "self",
            "phase": "shooting",
            "at": "start"
          },
          "optional": true,
          "observers": {
            "owner": "friendly",
            "eligibilityToMark": {
              "mustBeEligibleToShoot": true,
              "excludes": [
                "FORTIFICATION",
                "already-selected-to-shoot",
                "battle-shocked"
              ]
            }
          },
          "mark": {
            "owner": "enemy",
            "requiredPerEligibleObserver": true,
            "countPerObserver": 1,
            "visibleTo": "assigning-observer",
            "timesPerTargetPerPhase": 1,
            "duration": "end-of-phase"
          },
          "guided": {
            "owner": "friendly",
            "excludeObservers": true,
            "when": "targeting-spotted-enemy",
            "weaponBallisticSkillImprove": 1,
            "conditionalWeaponAbility": {
              "ifMarkingObserverHas": "MARKERLIGHT",

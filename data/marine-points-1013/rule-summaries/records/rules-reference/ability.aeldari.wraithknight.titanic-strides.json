  "data": {
    "ruleType": "unit-ability",
    "group": "Wraithknight",
    "summary": "During each [Normal move](vsdata:core-rule/normal-move), [Advance move](vsdata:core-rule/advance-move) or [fall-back move](vsdata:core-rule/fall-back) of this model, it can pass through models other than **TITANIC** models, and through terrain feature sections up to 4\" tall. While doing so:\n\n- it can enter enemy models' [Engagement Range](vsdata:core-rule/engagement-range), but must finish the move outside it\n- it can also pass through terrain feature sections taller than 4\"; if it does, roll a D6 after the move, and a 1 makes this model [battle-shocked](vsdata:core-rule/battle-shock)",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"
      }
    ],

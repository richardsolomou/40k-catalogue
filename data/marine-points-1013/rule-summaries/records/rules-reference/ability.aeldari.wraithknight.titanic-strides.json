      "version": "1",
      "fields": {
        "detail": {
          "ability": {
            "during": [
              "normal-move",
              "advance-move",
              "fall-back-move"
            ],
            "effects": [
              {
                "moveThrough": {
                  "models": {
                    "keywordsNone": [
                      "TITANIC"
                    ]
                  },
                  "terrainSectionsMaxHeightInches": 4
                }
              },
              {
                "mayCrossEngagementRange": true,
                "cannotEndWithinEngagementRange": true
              },
              {
                "moveThroughTallerTerrain": {
                  "overHeightInches": 4,
                  "afterMove": {
                    "roll": "D6",
                    "onResult": 1,

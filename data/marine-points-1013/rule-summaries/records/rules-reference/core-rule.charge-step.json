  "data": {
    "document": "Core Rules",
    "section": "11. Charge Phase",
    "ruleNumber": "11.02",
    "summary": "The active player declares and resolves charges one unit at a time, with whichever eligible units they choose. Choose a friendly unit that is eligible and has yet to declare a charge in this phase; it then declares one. Units on the battlefield qualify unless another rule says otherwise, but a unit is barred if it is more than 12\" from every enemy unit, if it is [engaged](vsdata:core-rule/engagement-range), or if it made an [Advance](vsdata:core-rule/advance-move) or a [Fall-Back](vsdata:core-rule/fall-back) move earlier in the turn. Next roll 2D6; the total is the furthest its [charge move](vsdata:core-rule/charge-move) can go. If a [charge move](vsdata:core-rule/charge-move) is possible and the player still wants it, the unit makes it, otherwise it does not; either way the charge is then resolved.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"
      },
      {
        "type": "publisher",
        "title": "Core Rules",
        "page": "36",
        "url": "https://assets.warhammer-community.com/eng_01-06_warhammer40k_new40k_core_rules-was6fbu1ix-hfewhmxyiy.pdf#page=36"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "phase-step",
          "phase": "charge",
          "actor": "active-player",
          "loop": {
            "unitsAtATime": 1,
            "until": "all-chosen-units-declared-and-resolved",
            "optionalPerUnit": true
          },
          "subSteps": [
            {
              "order": 1,
              "name": "Declare Charge",
              "select": {
                "count": 1,
                "side": "friendly",
                "notAlready": "declared-charge-this-phase",
                "constraint": "eligible-to-declare-charge"
              },
              "setsState": "declared-charge"
            },
            {
              "order": 2,
              "name": "Make Charge Roll",
              "roll": "2D6",
              "result": "maximum-charge-move-distance"
            },
            {
              "order": 3,
              "name": "Charge Move",
              "move": {
                "if": [
                  "charge-move-possible",
                  "player-still-wants"
                ],
                "otherwise": "no-charge-move"
              },
              "then": "charge-resolved"
            }
          ],
          "eligibility": {
            "requires": [
              "on-battlefield"
            ],
            "unlessOtherwiseStated": true,
            "ineligibleIf": [
              {
                "notWithinInches": 12,
                "of": "one-or-more-enemy-units"
              },
              {
                "state": "engaged"
              },
              {
                "madeThisTurn": [
                  "advance-move",
                  "fall-back-move"
                ]
              }
            ]
          },
          "noSkip": {
            "allUnitsSelected": false
          }
        }
      }
    }
  }

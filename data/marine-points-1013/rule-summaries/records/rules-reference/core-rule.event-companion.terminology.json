  "data": {
    "document": "Event Companion",
    "section": "Doubles Event Companion",
    "order": 106,
    "anchor": "terminology",
    "summary": "Doubles events use these terms:\n\n- **Force**: the 2 teammates' armies combined.\n- **Unified Force**: a force whose 2 armies have identical faction keywords; **ADEPTUS ASTARTES** units need not share Chapter keywords across the armies.\n- **Force of Convenience**: any other force.\n\nWhen classifying a force, ignore units taken as allies, such as an **IMPERIAL KNIGHTS** unit in an **IMPERIUM** army.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "mode": "doubles",
          "force": {
            "term": "Force",
            "players": 2,
            "armies": 2,
            "combined": true
          },
          "classification": {
            "unified": {
              "term": "Unified Force",
              "factionKeywordSets": "equal between both armies",
              "chapterException": {
                "scope": "Adeptus Astartes forces",
                "matchingChapterKeywordsRequired": false
              }
            },
            "otherwise": {
              "term": "Force of Convenience"
            },
            "excludeAlliedUnits": {
              "appliesTo": "force classification",
              "example": {
                "alliedUnitKeyword": "IMPERIAL KNIGHTS",
                "hostArmyKeyword": "IMPERIUM"
              }
            }
          }
        }
      }
    }
  }
}

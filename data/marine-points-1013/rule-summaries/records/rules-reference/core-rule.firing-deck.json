  "data": {
    "document": "Core Rules",
    "section": "24. Core Abilities",
    "ruleNumber": "24.14",
    "summary": "When this **[TRANSPORT](vsdata:core-rule/transports)** is [picked to shoot](vsdata:core-rule/shoot-step) in your [Shooting phase](vsdata:core-rule/shooting-phase) with units aboard, select up to X [embarked models](vsdata:core-rule/embarking). Skip models from units already chosen to shoot that phase. For each picked model, select one ranged weapon it carries, excluding [[ONE SHOT]](vsdata:core-rule/one-shot) weapons. Treat the **TRANSPORT** as equipped with all selected weapons as well as its own until it finishes attacking. The units aboard cannot shoot for the rest of the turn.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.7.1",
        "dataBuild": 972,
        "releaseDate": "2026-10-02"

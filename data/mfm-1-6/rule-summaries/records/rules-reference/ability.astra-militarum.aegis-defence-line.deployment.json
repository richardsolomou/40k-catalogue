    "ruleType": "unit-ability",
    "group": "Aegis Defence Line",
    "summary": "At setup, use exactly 1 platform section. Include up to 5 shields, up to 2 broken shields, plus a maximum of 2 end pieces. Join everything into one continuous line. The broken pair can sit at the line’s end. In the middle, they count as joined if separated by no more than ½″. For every rule, the assembled line counts as one model.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.8.0",
        "dataBuild": 981,
        "releaseDate": "2026-10-14"
      }
    ],
    "facts": {
      "format": "catalogue-core-facts",
      "fields": {
        "kind": "fortification-assembly",
        "trigger": "this-model-is-set-up",
        "sections": {
          "platform": {
            "required": 1
          },
          "shield": {
            "max": 5
          },
          "brokenShield": {
            "max": 2
          },
          "end": {
            "max": 2
          }
        },
        "connectedContinuousLine": true,
        "brokenShieldPair": {
          "placements": [
            "line-end",
            "middle-of-line"
          ],
          "middlePlacement": {
            "maxInchesBetweenSections": 0.5,
            "countsAsConnected": true
          }
        },
        "resultingModelCount": 1,
        "resultAppliesForAllRules": true

          "trigger": "own-command-phase",
          "count": 1,
          "recipients": "friendly-heretic-astartes-infantry",
          "expires": "next-own-command-phase-start"
        },
        "huronGrant": {
          "trigger": "each-phase-start",
          "source": "friendly-huron-blackheart-model",
          "eligible": "friendly-heretic-astartes-infantry-unit-visible-to-source",
          "count": 2,
          "expires": "current-phase-end"
        },
        "elite": {
          "beneficiary": "model-in-beneficiary-unit",
          "hitRollModifier": 1
        },

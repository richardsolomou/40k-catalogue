          "kind": "army-rule",
          "faction": "TITANICUS TRAITORIS",
          "condition": {
            "armyFaction": "TITANICUS TRAITORIS"
          },
          "when": "mustering",
          "effects": [
            {
              "skipStep": "Select Detachment Rules"
            },
            {
              "step": "Select Warlord",
              "select": {
                "side": "friendly",
                "count": 1,
                "keywordsAll": [

                "parameters": {
                  "turn": "your-turn"
                }
              }
            ]
          }
        },
        "scope": {
          "duration": "permanent"
        },
        "effect": {
          "type": "sequence",
          "steps": [
            {
              "type": "for-each-unit",
              "selector": {
                "filter": {
                  "owner": "friendly",
                  "all_of": [
                    "DEATH GUARD"
                  ]
                }
              },
              "effect": {
                "type": "sequence",
                "steps": [
                  {
                    "type": "objective-sticky",
                    "target": "recipient"

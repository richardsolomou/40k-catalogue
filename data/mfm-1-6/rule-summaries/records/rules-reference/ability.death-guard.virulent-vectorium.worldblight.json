                  }
                ]
              }
            },
            {
              "type": "ability-part",
              "effect": {
                "type": "for-each-unit",
                "selector": {
                  "filter": {
                    "owner": "enemy"
                  }
                },
                "effect": {
                  "type": "conditional",
                  "condition": {
                    "type": "matches",
                    "parameters": {
                      "subject": "recipient",
                      "filter": {

          "faction": "ADEPTUS TITANICUS",
          "condition": {
            "armyFaction": "ADEPTUS TITANICUS"
          },
          "when": "mustering",
          "effects": [
            {
              "skipStep": "Select Detachment Rules"
            },
            {
              "step": "Select Warlord",
              "select": {

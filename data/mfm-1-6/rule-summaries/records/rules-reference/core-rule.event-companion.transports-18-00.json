        "detail": {
          "appliesTo": "Doubles events",
          "coreRule": "18.00",
          "condition": "unified force",
          "permission": "embark in, or start the battle embarked in, a TRANSPORT model from the other army",
          "restrictions": "the unit must normally be able to embark in that TRANSPORT",
          "example": {

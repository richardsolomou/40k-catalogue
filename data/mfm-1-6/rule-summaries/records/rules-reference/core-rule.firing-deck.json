  "data": {
    "document": "Core Rules",
    "section": "24. Core Abilities",
    "ruleNumber": "24.14",
    "order": 271,
    "anchor": "24.14",
    "summary": "Whenever this **[TRANSPORT](vsdata:core-rule/transports)** is [picked to shoot](vsdata:core-rule/shoot-step) in your [Shooting phase](vsdata:core-rule/shooting-phase) with units embarked in it:\n\n1. Pick up to X [embarked models](vsdata:core-rule/embarking) whose units are not yet **selected to shoot** in this phase.\n2. For each, pick a ranged weapon it has, other than a **[[ONE SHOT]](vsdata:weapon-ability/one-shot)** weapon.\n3. The **TRANSPORT** has those weapons as well as its own until it has finished all its attacks.\n4. Units embarked in it cannot shoot for the rest of the turn.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.8.0",
        "dataBuild": 981,
        "releaseDate": "2026-10-14"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "datasheet-ability",
          "parameter": "X",
          "holderKeywords": [
            "TRANSPORT"
          ],
          "trigger": {
            "turn": "yours",
            "phase": "shooting",
            "event": "holderSelectedToShoot",
            "condition": "holderHasEmbarkedUnits",
            "rule": "10.02"
          },
          "steps": [
            {
              "step": 1,
              "select": {
                "level": "model",
                "upTo": "X",
                "pool": "embarkedModels",
                "excludeIfUnitAlreadySelectedToShootThisPhase": true
              }
            },
            {
              "step": 2,
              "select": {
                "perSelectedModel": 1,
                "weapons": "ranged",
                "excludingWeaponAbilities": [
                  "ONE SHOT"
                ],
                "rule": "24.26"
              }
            },
            {
              "step": 3,
              "grant": {
                "to": "holder",
                "weapons": "step2Selections",
                "inAdditionToOwn": true,
                "until": "holderAttacksResolved"
              }
            },
            {
              "step": 4,
              "restrict": {
                "units": "allEmbarkedUnits",
                "eligibleToShoot": false,
                "until": "endOfTurn"
              }
            }
          ]
        }
      }
    }

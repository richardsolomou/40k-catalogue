      "version": "1",
      "fields": {
        "detail": {
          "subject": "unit",
          "roll": "D6",
          "failsOn": [
            1,
            2
          ],
          "onFailure": {
            "mortalWounds": 1,
            "mortalWoundsRef": "06.02",
            "allModelsWithAnyKeyword": {
              "keywords": [
                "MONSTER",
                "VEHICLE"
              ],
              "mortalWounds": 3
            }
          },

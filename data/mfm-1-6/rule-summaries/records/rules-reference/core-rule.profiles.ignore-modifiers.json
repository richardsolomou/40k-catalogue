    "parent": {
      "kind": "core-rule",
      "id": "profiles"
    },
    "summary": "A rule that lets a unit, model, weapon or player ignore modifiers applies, unless stated otherwise, to modifiers of its rolls, its profile and its weapon characteristics.\n\nWhere it names a roll or characteristic, you may ignore all of its modifiers or only some, such as ignoring the penalties while keeping the bonuses.",
    "citations": [
      {
        "type": "app",
        "title": "Warhammer 40,000: The App",
        "appVersion": "2.8.0",
        "dataBuild": 981,
        "releaseDate": "2026-10-14"
      }
    ],
    "facts": {
      "format": "vs-data-facts",
      "version": "1",
      "fields": {
        "detail": {
          "kind": "clarification",
          "ruleNumber": "02.02.02",
          "ruleNumberParts": [
            2,
            2,
            2
          ],
          "defaultScope": [
            "unit-rolls",
            "unit-profile",
            "weapon-characteristics"
          ],
          "unlessOtherwiseStated": true,
          "namedRollOrCharacteristic": {
            "ignore": "all-or-some-modifiers"
          },
          "examples": [
            {
              "characteristic": "M",
              "bonusInches": 2,
              "penaltyInches": -2,
              "ignored": "penalty"
            },
            {
              "roll": "hit",
              "bonus": 1,
              "penalty": -1,
              "ignored": "penalty"
            }
          ]
        }
      }
    }

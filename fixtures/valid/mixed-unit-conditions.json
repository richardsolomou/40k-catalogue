      "inches": 12,
      "of": "target"
    }
  ],
  "effect": {
    "kind": "modify-roll",
    "roll": "hit",
    "by": 1
  },
  "duration": {
    "until": "end-of-turn"
  },
  "summary": "When an enemy unit ends a Normal or Fall Back move, if that unit is Battle-shocked, select one friendly unit that was Below Half-strength at the start of the phase, is within 12\" of this unit and is within 6\" of that unit, then add 1 to Hit rolls for the selected unit until the end of the turn."

  "source": { "title": "Synthetic Test Rules", "page": "1" },
  "id": "synthetic.kindled-blades",
  "name": "Kindled Blades",
  "usage": { "cp": 1, "windows": [{ "phase": "fight", "turn": "any" }] },
  "trigger": { "kind": "use" },
  "target": { "select": { "side": "friendly", "keywords": ["Infantry"] } },
  "conditions": [{ "kind": "not-selected", "unit": "target", "to": ["fight"] }],
  "effect": {
    "kind": "grant-weapon-abilities",
    "weapons": "melee",
    "abilities": [{ "ability": "sustained-hits", "value": 1 }, { "ability": "anti", "keyword": "Monster", "threshold": 4 }, { "ability": "lance" }]
  },
  "duration": { "until": "end-of-phase" },
  "summary": "During either player's Fight phase, you can use this to select one friendly Infantry unit that has not been selected to fight this phase, then grant [SUSTAINED HITS 1], [ANTI-MONSTER 4+] and [LANCE] to melee weapons equipped by models in the selected unit until the end of the phase."

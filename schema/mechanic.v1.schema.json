{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/vs-data/schema/mechanic.v1.schema.json",
  "title": "Mechanic record, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "rulesVersion",
    "source",
    "trigger",
    "target",
    "conditions",
    "effect"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "summaryTerms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "anyOf": [{ "required": ["bold"] }, { "required": ["target"] }],
        "properties": {
          "label": { "$ref": "#/$defs/text" },
          "bold": { "const": true },
          "target": { "$ref": "#/$defs/summaryTarget" }
        }
      }
    },
    "summarySpans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": false,
        "anyOf": [{ "required": ["bold"] }, { "required": ["target"] }],
        "properties": {
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 },
          "bold": { "const": true },
          "target": { "$ref": "#/$defs/summaryTarget" }
        }
      }
    },
    "rulesVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "update"
      ],
      "properties": {
        "edition": {
          "$ref": "#/$defs/text"
        },
        "update": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "anyOf": [
        {
          "required": [
            "page"
          ],
          "type": "object"
        },
        {
          "required": [
            "url"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "page": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "credit", "licence", "changes"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://\\S+$" },
        "revision": { "$ref": "#/$defs/text" },
        "credit": { "$ref": "#/$defs/text" },
        "licence": { "type": "string", "pattern": "^https://\\S+$" },
        "changes": { "$ref": "#/$defs/text" }
      }
    },
    "trigger": {
      "if": {
        "required": [
          "unresolved"
        ],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/unresolved"
      },
      "else": {
        "$ref": "#/$defs/trigger"
      }
    },
    "target": {
      "if": {
        "required": [
          "unresolved"
        ],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/unresolved"
      },
      "else": {
        "$ref": "#/$defs/target"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "if": {
          "required": [
            "unresolved"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "#/$defs/unresolved"
        },
        "else": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "effect": {
      "if": {
        "required": [
          "unresolved"
        ],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/unresolved"
      },
      "else": {
        "$ref": "#/$defs/effect"
      }
    },
    "duration": {
      "if": {
        "required": [
          "unresolved"
        ],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/unresolved"
      },
      "else": {
        "$ref": "#/$defs/duration"
      }
    },
    "restriction": {
      "if": {
        "required": [
          "unresolved"
        ],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/unresolved"
      },
      "else": {
        "$ref": "#/$defs/restriction"
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cp": {
          "type": "integer",
          "minimum": 0
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turn"
            ],
            "properties": {
              "phase": {
                "$ref": "#/$defs/phase"
              },
              "turn": {
                "enum": [
                  "own",
                  "opponent",
                  "any"
                ]
              }
            }
          }
        },
        "oncePerTurn": {
          "const": true
        },
        "bearerModel": {
          "$ref": "#/$defs/text"
        },
        "oncePerPhase": {
          "const": true
        }
      },
      "not": {
        "required": [
          "oncePerTurn",
          "oncePerPhase"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "effect"
        ],
        "properties": {
          "effect": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "modify-roll",
                  "modify-characteristic",
                  "re-roll",
                  "grant-weapon-abilities",
                  "grant-abilities"
                ]
              }
            },
            "type": "object"
          },
          "trigger": {
            "not": {
              "properties": {
                "kind": {
                  "const": "always"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "duration"
        ],
        "type": "object"
      }
    },
    {
      "if": {
        "required": [
          "effect"
        ],
        "properties": {
          "effect": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "mortal-wounds",
                  "activate-ability",
                  "desperate-escape-tests",
                  "enemy-distance"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "type": "object",
        "properties": {
          "duration": false,
          "trigger": {
            "not": {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "always" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "trigger"
        ],
        "properties": {
          "trigger": {
            "properties": {
              "kind": {
                "const": "always"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "type": "object",
        "properties": {
          "duration": false,
          "target": {
            "not": {
              "required": [
                "select"
              ],
              "type": "object"
            }
          },
          "usage": {
            "propertyNames": {
              "const": "bearerModel"
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "trigger"
        ],
        "properties": {
          "trigger": {
            "properties": {
              "kind": {
                "const": "use"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "type": "object",
        "required": [
          "usage"
        ],
        "properties": {
          "usage": {
            "required": [
              "windows"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "summaryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
      }
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved"
      ],
      "properties": {
        "unresolved": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "phase": {
      "enum": [
        "command",
        "movement",
        "shooting",
        "charge",
        "fight"
      ]
    },
    "unitRef": {
      "enum": [
        "this-unit",
        "triggering-unit",
        "triggering-model",
        "destroying-unit",
        "target"
      ]
    },
    "unitFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side"
      ],
      "properties": {
        "side": {
          "$ref": "#/$defs/side"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "excludedKeywords": {
          "$ref": "#/$defs/keywords"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inches",
        "of"
      ],
      "properties": {
        "inches": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "engagement-range"
            }
          ]
        },
        "of": {
          "$ref": "#/$defs/unitRef"
        }
      }
    },
    "kinded": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "trigger": {
      "$ref": "#/$defs/kinded",
      "properties": {
        "kind": {
          "enum": [
            "phase-start",
            "phase-end",
            "move-end",
            "move-selected",
            "ability-move",
            "model-destroyed",
            "unit-destroyed",
            "always",
            "use"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "phase-start",
                  "phase-end"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "phase",
              "turn"
            ],
            "properties": {
              "kind": true,
              "phase": {
                "$ref": "#/$defs/phase"
              },
              "turn": {
                "enum": [
                  "own",
                  "opponent",
                  "any"
                ]
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "move-end",
                  "move-selected"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "moves",
              "unit"
            ],
            "properties": {
              "kind": true,
              "moves": {
                "$ref": "#/$defs/moves"
              },
              "unit": {
                "$ref": "#/$defs/unitFilter"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ability-move"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "ability",
              "moves"
            ],
            "properties": {
              "kind": true,
              "ability": {
                "$ref": "#/$defs/text"
              },
              "moves": {
                "$ref": "#/$defs/moves"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model-destroyed"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "unit"
            ],
            "properties": {
              "kind": true,
              "unit": {
                "$ref": "#/$defs/unitFilter"
              },
              "beforeRoll": {
                "const": "deadly-demise"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unit-destroyed"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "unit",
              "by"
            ],
            "properties": {
              "kind": true,
              "unit": {
                "$ref": "#/$defs/unitFilter"
              },
              "by": {
                "$ref": "#/$defs/unitFilter"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "always",
                  "use"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "kind": true
            },
            "type": "object"
          }
        }
      ],
      "type": "object"
    },
    "target": {
      "type": "object",
      "properties": {
        "unit": {
          "enum": [
            "this-unit",
            "triggering-unit",
            "triggering-model"
          ]
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "side"
          ],
          "properties": {
            "side": {
              "$ref": "#/$defs/side"
            },
            "keywords": {
              "$ref": "#/$defs/keywords"
            },
            "within": {
              "$ref": "#/$defs/range"
            },
            "excludedKeywords": {
              "$ref": "#/$defs/keywords"
            }
          }
        },
        "allowDestroyed": {
          "const": true
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "unit"
          ],
          "not": {
            "required": [
              "select"
            ]
          }
        },
        {
          "required": [
            "select"
          ],
          "not": {
            "required": [
              "unit"
            ]
          }
        }
      ],
      "dependentSchemas": {
        "allowDestroyed": {
          "required": [
            "unit"
          ],
          "properties": {
            "unit": {
              "const": "triggering-model"
            }
          }
        }
      }
    },
    "condition": {
      "$ref": "#/$defs/kinded",
      "properties": {
        "kind": {
          "enum": [
            "status",
            "within",
            "not-selected",
            "source-model-leading"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "source-model-leading" } }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "kind": true }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "status"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "unit",
              "status",
              "at"
            ],
            "properties": {
              "kind": true,
              "unit": {
                "$ref": "#/$defs/unitRef"
              },
              "status": {
                "enum": [
                  "battle-shocked",
                  "below-half-strength",
                  "unravelling"
                ]
              },
              "at": {
                "enum": [
                  "now",
                  "phase-start",
                  "turn-start"
                ]
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "within"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "unit",
              "inches",
              "of"
            ],
            "properties": {
              "kind": true,
              "unit": {
                "$ref": "#/$defs/unitRef"
              },
              "inches": {
                "type": "integer",
                "minimum": 1
              },
              "of": {
                "$ref": "#/$defs/unitRef"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "not-selected"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "unit",
              "to"
            ],
            "properties": {
              "kind": true,
              "unit": {
                "$ref": "#/$defs/unitRef"
              },
              "to": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "shoot",
                    "fight"
                  ]
                }
              }
            },
            "type": "object"
          }
        }
      ],
      "type": "object"
    },
    "effect": {
      "$ref": "#/$defs/kinded",
      "properties": {
        "kind": {
          "enum": [
            "modify-roll",
            "modify-characteristic",
            "re-roll",
            "grant-weapon-abilities",
            "grant-abilities",
            "mortal-wounds",
            "roll-threshold",
            "activate-ability",
            "desperate-escape-tests",
            "enemy-distance"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "modify-roll"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "roll",
              "by"
            ],
            "properties": {
              "kind": true,
              "roll": {
                "$ref": "#/$defs/roll"
              },
              "by": {
                "$ref": "#/$defs/modifier"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "re-roll"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "roll",
              "results"
            ],
            "properties": {
              "kind": true,
              "roll": {
                "$ref": "#/$defs/roll"
              },
              "results": {
                "enum": [
                  "all",
                  "ones"
                ]
              },
              "weapons": {
                "$ref": "#/$defs/weaponType"
              }
            },
            "dependentSchemas": {
              "weapons": {
                "properties": {
                  "roll": {
                    "enum": [
                      "hit",
                      "wound"
                    ]
                  }
                }
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grant-weapon-abilities"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "abilities"
            ],
            "properties": {
              "kind": true,
              "abilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/weaponAbility"
                }
              },
              "weapons": {
                "$ref": "#/$defs/weaponType"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grant-abilities"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "abilities"
            ],
            "properties": {
              "kind": true,
              "abilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/coreAbility"
                }
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "modify-characteristic"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "characteristic",
              "by"
            ],
            "properties": {
              "kind": true,
              "characteristic": {
                "enum": [
                  "move",
                  "toughness",
                  "save",
                  "leadership",
                  "objective-control",
                  "attacks"
                ]
              },
              "by": {
                "$ref": "#/$defs/modifier"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mortal-wounds"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "amount"
            ],
            "properties": {
              "kind": true,
              "amount": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]*|[1-9]?D[36])$"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {

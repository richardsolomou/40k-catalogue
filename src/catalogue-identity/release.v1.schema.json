{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/vs-data/src/catalogue-identity/release.v1.schema.json",
  "title": "Catalogue identity release, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "rulesVersion", "revision", "entries"],
  "properties": {
    "formatVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "rulesVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "update"],
      "properties": {
        "edition": { "$ref": "#/$defs/text" },
        "update": { "$ref": "#/$defs/text" }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "#/$defs/slug" },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "$ref": "#/$defs/slug" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "aliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "retired": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replacedBy"],
          "properties": {
            "replacedBy": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "references": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/40k-catalogue/src/catalogue-releases/categories.v1.schema.json",
  "title": "Catalogue release category declarations, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "categories"],
  "properties": {
    "formatVersion": { "const": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "kinds", "sources"],
        "properties": {
          "name": { "$ref": "definitions.v1.schema.json#/$defs/slug" },
          "status": { "enum": ["included", "retained"] },
          "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "definitions.v1.schema.json#/$defs/slug" } },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "definitions.v1.schema.json#/$defs/source" } }
        },
        "if": { "properties": { "status": { "const": "retained" } } },
        "then": { "properties": { "sources": { "items": { "type": "object", "required": ["revision"] } } } }
      }
    }
  }
}

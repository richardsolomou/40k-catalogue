{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/40k-catalogue/src/catalogue-releases/manifest.v1.schema.json",
  "title": "Catalogue release manifest, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "release",
    "commit",
    "rulesVersion",
    "revision",
    "previous",
    "schemas",
    "identity",
    "categories"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "release": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rulesVersion": {
      "$ref": "definitions.v1.schema.json#/$defs/rulesVersion"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "rulesVersion",
            "revision",
            "manifest"
          ],
          "properties": {
            "release": {
              "$ref": "#/properties/release"
            },
            "rulesVersion": {
              "$ref": "definitions.v1.schema.json#/$defs/rulesVersion"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "manifest": {
              "$ref": "definitions.v1.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "identity": {
      "$ref": "#/$defs/file"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "statusBefore",
          "kinds",
          "sources",
          "entries",
          "records",
          "unresolved",
          "unresolvedReferences",
          "dependsOn",
          "changes"
        ],
        "properties": {
          "name": {
            "$ref": "definitions.v1.schema.json#/$defs/slug"
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "retained"
            ]
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "definitions.v1.schema.json#/$defs/slug"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "definitions.v1.schema.json#/$defs/source"
            }
          },
          "entries": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "path",
                "sha256"
              ],
              "properties": {
                "kind": {
                  "$ref": "definitions.v1.schema.json#/$defs/slug"
                },
                "id": {
                  "$ref": "definitions.v1.schema.json#/$defs/id"
                },
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "definitions.v1.schema.json#/$defs/sha256"
                }
              }
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "$ref": "definitions.v1.schema.json#/$defs/ref"
            }
          },
          "unresolvedReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "definitions.v1.schema.json#/$defs/ref"
                },
                "to": {
                  "$ref": "definitions.v1.schema.json#/$defs/ref"
                }
              }
            }
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "definitions.v1.schema.json#/$defs/slug"
            }
          },
          "statusBefore": {
            "enum": [
              "complete",
              "partial",
              "retained",
              null
            ]
          },
          "changes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "added",
              "renamed",
              "aliased",
              "retired",
              "recordsAdded",
              "recordsChanged",
              "recordsRemoved"
            ],
            "properties": {
              "added": {
                "type": "array",
                "items": {
                  "$ref": "definitions.v1.schema.json#/$defs/ref"
                }
              },
              "renamed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "from",
                    "to"
                  ],
                  "properties": {
                    "kind": {
                      "$ref": "definitions.v1.schema.json#/$defs/slug"
                    },
                    "id": {
                      "$ref": "definitions.v1.schema.json#/$defs/id"
                    },
                    "from": {
                      "$ref": "definitions.v1.schema.json#/$defs/text"
                    },
                    "to": {
                      "$ref": "definitions.v1.schema.json#/$defs/text"
                    }
                  }
                }
              },
              "aliased": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "canonical"
                  ],
                  "properties": {
                    "kind": {
                      "$ref": "definitions.v1.schema.json#/$defs/slug"
                    },
                    "id": {
                      "$ref": "definitions.v1.schema.json#/$defs/id"
                    },
                    "canonical": {
                      "$ref": "definitions.v1.schema.json#/$defs/id"
                    }
                  }
                }
              },
              "retired": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "replacedBy"
                  ],
                  "properties": {
                    "kind": {
                      "$ref": "definitions.v1.schema.json#/$defs/slug"
                    },
                    "id": {
                      "$ref": "definitions.v1.schema.json#/$defs/id"
                    },
                    "replacedBy": {
                      "type": "array",
                      "items": {
                        "$ref": "definitions.v1.schema.json#/$defs/id"
                      }
                    }
                  }
                }
              },
              "recordsAdded": {
                "type": "array",
                "items": {
                  "$ref": "definitions.v1.schema.json#/$defs/ref"
                }
              },
              "recordsChanged": {
                "type": "array",
                "items": {
                  "$ref": "definitions.v1.schema.json#/$defs/ref"
                }
              },
              "recordsRemoved": {
                "type": "array",
                "items": {
                  "$ref": "definitions.v1.schema.json#/$defs/ref"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "definitions.v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}

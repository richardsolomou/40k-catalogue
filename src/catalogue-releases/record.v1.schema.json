{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/40k-catalogue/src/catalogue-releases/record.v1.schema.json",
  "title": "Catalogue category record, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "id", "rulesVersion", "source", "data"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "$ref": "definitions.v1.schema.json#/$defs/slug" },
    "id": { "$ref": "definitions.v1.schema.json#/$defs/id" },
    "rulesVersion": { "$ref": "definitions.v1.schema.json#/$defs/rulesVersion" },
    "source": { "$ref": "definitions.v1.schema.json#/$defs/source" },
    "data": { "type": "object" }
  }
}

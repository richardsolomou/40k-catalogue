{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/40k-catalogue/src/points/points.v1.schema.json",
  "title": "Points snapshot, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "id", "rulesVersion", "published", "source", "basis", "factions"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "points-snapshot" },
    "id": { "$ref": "#/$defs/id" },
    "rulesVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "update"],
      "properties": {
        "edition": { "$ref": "#/$defs/text" },
        "update": { "$ref": "#/$defs/text" }
      }
    },
    "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "anyOf": [{ "required": ["url"] }, { "required": ["page"] }],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https://\\S+$" },
        "page": { "$ref": "#/$defs/text" },
        "revision": { "$ref": "#/$defs/text" }
      }
    },
    "basis": { "$ref": "#/$defs/text" },
    "factions": { "type": "array", "items": { "$ref": "#/$defs/faction" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved"],
      "properties": { "unresolved": { "$ref": "#/$defs/text" } }
    },
    "points": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/unresolved" }] },
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "detachments", "units"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "detachments": { "type": "array", "items": { "$ref": "#/$defs/detachment" } },
        "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } }
      }
    },
    "detachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "dp", "enhancements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "dp": { "$ref": "#/$defs/points" },
        "enhancements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "points"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/text" },
              "upgrade": { "const": true },
              "points": { "$ref": "#/$defs/points" }
            }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tiers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "group": { "$ref": "#/$defs/text" },
        "legends": { "const": true },
        "tiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tier" } },
        "wargear": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "points"],
            "properties": {
              "item": { "$ref": "#/$defs/text" },
              "points": { "$ref": "#/$defs/points" }
            }
          }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copies", "costs"],
      "properties": {
        "copies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": { "type": "integer", "minimum": 1 },
            "to": { "type": "integer", "minimum": 1 }
          }
        },
        "costs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["models", "points"],
            "properties": {
              "models": { "type": "integer", "minimum": 1 },
              "composition": { "$ref": "#/$defs/text" },
              "points": { "$ref": "#/$defs/points" }
            }
          }
        }
      }
    }
  }
}

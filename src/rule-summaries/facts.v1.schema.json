{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/vs-data/src/rule-summaries/facts.v1.schema.json",
  "title": "Rule summary typed facts: vs-data-facts version 1",
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "keyword": {
      "type": "string",
      "pattern": "^[^a-z]*[A-Z0-9][^a-z]*$"
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/keyword"
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    },
    "detail": {
      "type": "object",
      "minProperties": 1
    },
    "enhancement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "eligibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "model",
            "unit",
            "upgrade"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "perRoster": {
          "type": "integer",
          "minimum": 2
        },
        "outsideLimit": {
          "const": true
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anyOf"
          ],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "keywords": {
                    "$ref": "#/$defs/keywords"
                  },
                  "factionKeywords": {
                    "$ref": "#/$defs/keywords"
                  },
                  "unit": {
                    "$ref": "#/$defs/ref"
                  }
                }
              }
            },
            "excludedKeywords": {
              "$ref": "#/$defs/keywords"
            },
            "requiredWargear": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "epicHeroes": {
              "const": true
            },
            "nonCharacters": {
              "const": true
            },
            "notWarlord": {
              "const": true
            }
          }
        }
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "cumulative",
        "mutuallyExclusive"
      ],
      "properties": {
        "count": {
          "enum": [
            "once",
            "each"
          ]
        },
        "scoring": {
          "enum": [
            "standard",
            "fixed",
            "tactical"
          ]
        },
        "cumulative": {
          "type": "boolean"
        },
        "mutuallyExclusive": {
          "type": "boolean"
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "endOfBattle": {
          "const": true
        }
      }
    },
    "plain": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "detail": {
          "$ref": "#/$defs/detail"
        }
      }
    },
    "stratagem": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stratagem": {
          "$ref": "#/$defs/stratagem-block"
        },
        "grants": {
          "$ref": "#/$defs/grants"
        },
        "weaponAbilities": {
          "$ref": "#/$defs/weapon-abilities"
        },
        "reserves": {
          "$ref": "#/$defs/reserves"
        },
        "invulnerableSave": {
          "$ref": "#/$defs/invulnerable-save"
        },
        "upgradesWeapon": {
          "const": true
        },
        "reminder": {
          "$ref": "#/$defs/reminder"
        },
        "roster": {
          "$ref": "#/$defs/roster"
        },
        "attachment": {
          "$ref": "#/$defs/attachment-claim"
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "combat": {
          "$ref": "#/$defs/combat"
        },
        "detail": {
          "$ref": "#/$defs/detail"
        }
      }
    },
    "enhancement-fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "enhancement": {
          "$ref": "#/$defs/enhancement"
        },
        "grants": {
          "$ref": "#/$defs/grants"
        },
        "weaponAbilities": {
          "$ref": "#/$defs/weapon-abilities"
        },
        "reserves": {
          "$ref": "#/$defs/reserves"
        },
        "invulnerableSave": {
          "$ref": "#/$defs/invulnerable-save"
        },
        "upgradesWeapon": {
          "const": true
        },
        "reminder": {
          "$ref": "#/$defs/reminder"
        },
        "roster": {
          "$ref": "#/$defs/roster"
        },
        "attachment": {
          "$ref": "#/$defs/attachment-claim"
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "combat": {
          "$ref": "#/$defs/combat"
        },
        "detail": {
          "$ref": "#/$defs/detail"
        }
      }
    },
    "mission-award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "award"
      ],
      "properties": {
        "award": {
          "$ref": "#/$defs/award"
        },
        "detail": {
          "$ref": "#/$defs/detail"
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved"
      ],
      "properties": {
        "unresolved": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "enum": [
            "phase",
            "phase-start",
            "phase-end",
            "turn-start",
            "turn-end",
            "reinforcements-step"
          ]
        },
        "after": {
          "if": {
            "type": "object",
            "required": [
              "unresolved"
            ]
          },
          "then": {
            "$ref": "#/$defs/unresolved"
          },
          "else": {
            "enum": [
              "enemy-selected-targets",
              "enemy-shot",
              "enemy-fought",
              "enemy-shot-or-fought",
              "enemy-declared-charge",
              "enemy-ended-charge",
              "enemy-ended-move",
              "enemy-set-up",
              "friendly-fell-back",
              "friendly-ended-charge",
              "friendly-declared-charge",
              "friendly-selected-to-advance-or-fall-back",
              "friendly-selected-to-fall-back",
              "friendly-selected-to-advance",
              "friendly-selected-to-consolidate",
              "friendly-selected-to-move",
              "friendly-selected-to-attack",
              "friendly-selected-to-shoot",
              "friendly-selected-to-fight",
              "friendly-ended-advance",
              "friendly-suffered-mortal-wound",
              "friendly-started-action",
              "friendly-shot",
              "friendly-fought",
              "friendly-destroyed-enemy",
              "friendly-destroyed"
            ]
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "count"
          ]
        },
        {
          "required": [
            "triggering"
          ]
        }
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "triggering": {
          "const": true
        },
        "side": {
          "enum": [
            "friendly",
            "enemy"
          ]
        },
        "entity": {
          "enum": [
            "unit",
            "model"
          ]
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "anyOf": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keywords"
            ],
            "properties": {
              "keywords": {
                "$ref": "#/$defs/keywords"
              }
            }
          }
        },
        "excludedKeywords": {
          "$ref": "#/$defs/keywords"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "not-selected-to-shoot-or-fight",
              "not-selected-to-shoot",
              "not-selected-to-fight",
              "not-selected-to-move-or-charge",
              "not-selected-to-move",
              "targeted-by-the-attacking-unit",
              "not-in-engagement-range",
              "in-engagement-range",
              "just-destroyed",
              "arriving-by-deep-strike",
              "battle-shocked",
              "below-half-strength",
              "unengaged"
            ]
          }
        },
        "more": {
          "const": true
        }
      }
    },
    "stratagem-block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "when",
        "target"
      ],
      "properties": {
        "limit": {
          "enum": [
            "phase",
            "turn",
            "battle-round",
            "battle"
          ]
        },
        "perTarget": {
          "enum": [
            "phase",
            "turn",
            "battle-round",
            "battle"
          ]
        },
        "restricted": {
          "const": true
        },
        "when": {
          "if": {
            "type": "object",
            "required": [
              "unresolved"
            ]
          },
          "then": {
            "$ref": "#/$defs/unresolved"
          },
          "else": {
            "$ref": "#/$defs/when"
          }
        },
        "target": {
          "if": {
            "type": "object",
            "required": [
              "unresolved"
            ]
          },
          "then": {
            "$ref": "#/$defs/unresolved"
          },
          "else": {
            "$ref": "#/$defs/target"
          }
        },
        "extraCp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cp"
          ],
          "properties": {
            "cp": {
              "type": "integer",
              "minimum": 1
            },
            "exclusive": {
              "const": true
            }
          }
        }
      }
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/keyword"
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ability",
        "to"
      ],
      "properties": {
        "ability": {
          "$ref": "#/$defs/text"
        },
        "to": {
          "enum": [
            "bearer",
            "leader",
            "unit",
            "models"
          ]
        },
        "models": {
          "$ref": "#/$defs/keyword"
        },
        "named": {
          "const": true
        },
        "whileAttached": {
          "const": true
        },
        "counterpart": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "linked": {
          "const": true
        },
        "against": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "psychic-attacks",
              "mortal-wounds"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "to": {
            "const": "models"
          }
        }
      },
      "then": {
        "required": [
          "models"
        ]
      },
      "else": {
        "not": {
          "required": [
            "models"
          ]
        }
      }
    },
    "grant-statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abilities"
      ],
      "properties": {
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        }
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "normalized": {
          "oneOf": [
            {
              "$ref": "#/$defs/grant-statement"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "weapon-ability-grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ability",
        "attacks",
        "to"
      ],
      "properties": {
        "ability": {
          "$ref": "#/$defs/keyword"
        },
        "attacks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ranged",
              "melee"
            ]
          }
        },
        "to": {
          "enum": [
            "army",
            "own-unit",
            "led-unit"
          ]
        },
        "keywords": {
          "$ref": "#/$defs/selectors"
        },
        "excludedKeywords": {
          "$ref": "#/$defs/selectors"
        }
      },
      "if": {
        "properties": {
          "to": {
            "const": "army"
          }
        }
      },
      "then": {
        "required": [
          "keywords"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "keywords"
              ]
            },
            {
              "required": [
                "excludedKeywords"
              ]
            }
          ]
        }
      }
    },
    "weapon-abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/weapon-ability-grant"
      }
    },
    "reserves": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "exempt": {
          "const": true
        },
        "exemptUnits": {
          "$ref": "#/$defs/selectors"
        }
      }
    },
    "invulnerable-save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roll"
      ],
      "properties": {
        "roll": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "enum": [
            "phase-start",
            "phase-end",
            "turn-start",
            "turn-end",
            "round-start",
            "round-end"
          ]
        },
        "phase": {
          "enum": [
            "command",
            "movement",
            "shooting",
            "charge",
            "fight",
            "any"
          ]
        },
        "turn": {
          "enum": [
            "own",
            "opponent",
            "any"
          ]
        },
        "firstRoundOnly": {
          "const": true
        }
      },
      "if": {
        "properties": {
          "at": {
            "enum": [
              "phase-start",
              "phase-end"
            ]
          }
        }
      },
      "then": {
        "required": [
          "phase",
          "turn"
        ]
      },
      "else": {
        "not": {
          "required": [
            "phase"
          ]
        }
      }
    },
    "reminder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timings"
      ],
      "properties": {
        "timings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timing"
          }
        },
        "whileDestroyed": {
          "const": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "timings": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "whileDestroyed"
          ]
        }
      ]
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "addsUnits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "trigger",
              "shared"
            ],
            "properties": {
              "unit": {
                "$ref": "#/$defs/text"
              },
              "trigger": {
                "enum": [
                  "shooting",
                  "kill"
                ]
              },
              "shared": {
                "type": "boolean"
              }
            }
          }
        },
        "movement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "advance-and-charge",
              "surge-after-enemy-shooting"
            ]
          }
        }
      }
    },
    "attachment-claim": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "requiresLeader": {
          "const": true
        },
        "substitutes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "dependentRequired": {
        "requiresLeader": [
          "units"
        ]
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "unit-target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selectors"
          }
        },
        "excluded": {
          "$ref": "#/$defs/selectors"
        },
        "none": {
          "const": true
        }
      },
      "if": {
        "required": [
          "none"
        ]
      },
      "then": {
        "maxProperties": 1
      }
    },
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unitHas"
          ],
          "properties": {
            "unitHas": {
              "$ref": "#/$defs/keyword"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "everyModelHas"
          ],
          "properties": {
            "everyModelHas": {
              "$ref": "#/$defs/keyword"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyword"
          ],
          "properties": {
            "keyword": {
              "$ref": "#/$defs/keyword"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "psychic"
          ],
          "properties": {
            "psychic": {
              "const": true
            }
          }
        }
      ]
    },
    "tree-node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reading"
          ],
          "properties": {
            "reading": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ask",
            "yes",
            "no"
          ],
          "properties": {
            "ask": {
              "$ref": "#/$defs/question"
            },
            "yes": {
              "type": "integer",
              "minimum": 0
            },
            "no": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "option",
                "leading",
                "selected-target",
                "activated",
                "selected-visible-attacker",
                "set-up-as-reinforcements",
                "charged",
                "remained-stationary",
                "target-in-engagement-range",
                "selected-target-in-engagement-range",
                "target-closest",
                "target-on-objective",
                "source-destroyed-unit"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inches"
          ],
          "properties": {
            "kind": {
              "enum": [
                "within",
                "attacker-within",
                "selected-unit-within",
                "selected-target-within",
                "objective-within",
                "target-within"
              ]
            },
            "inches": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "min",
            "max"
          ],
          "properties": {
            "kind": {
              "const": "wounds-remaining"
            },
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "attacks",
            "roll"
          ],
          "properties": {
            "kind": {
              "const": "roll"
            },
            "attacks": {
              "enum": [
                "ranged",
                "melee"
              ]
            },
            "roll": {
              "enum": [
                "hit",
                "wound"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "turn"
          ],
          "properties": {
            "kind": {
              "const": "activated-at-start"
            },
            "turn": {
              "enum": [
                "own",
                "opponent",
                "any"

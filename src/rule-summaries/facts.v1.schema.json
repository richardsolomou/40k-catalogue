{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/vs-data/src/rule-summaries/facts.v1.schema.json",
  "title": "Rule summary typed facts: vs-data-facts version 1",
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "keyword": { "type": "string", "pattern": "^[^a-z]*[A-Z0-9][^a-z]*$" },
    "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/keyword" } },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
      }
    },
    "detail": { "type": "object", "minProperties": 1 },
    "enhancement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "eligibility"],
      "properties": {
        "type": { "enum": ["model", "unit", "upgrade"] },
        "points": { "type": "integer", "minimum": 0 },
        "perRoster": { "type": "integer", "minimum": 2 },
        "outsideLimit": { "const": true },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anyOf"],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "keywords": { "$ref": "#/$defs/keywords" },
                  "factionKeywords": { "$ref": "#/$defs/keywords" },
                  "unit": { "$ref": "#/$defs/ref" }
                }
              }
            },
            "excludedKeywords": { "$ref": "#/$defs/keywords" },
            "requiredWargear": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
            "epicHeroes": { "const": true },
            "nonCharacters": { "const": true },
            "notWarlord": { "const": true }
          }
        }
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "cumulative", "mutuallyExclusive"],
      "properties": {
        "count": { "enum": ["once", "each"] },
        "scoring": { "enum": ["standard", "fixed", "tactical"] },
        "cumulative": { "type": "boolean" },
        "mutuallyExclusive": { "type": "boolean" },
        "rounds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "endOfBattle": { "const": true }
      }
    },
    "plain": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "detail": { "$ref": "#/$defs/detail" } }
    },
    "stratagem": { "$ref": "#/$defs/plain" },
    "enhancement-fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "enhancement": { "$ref": "#/$defs/enhancement" }, "detail": { "$ref": "#/$defs/detail" } }
    },
    "mission-award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["award"],
      "properties": { "award": { "$ref": "#/$defs/award" }, "detail": { "$ref": "#/$defs/detail" } }
    }
  }
}
